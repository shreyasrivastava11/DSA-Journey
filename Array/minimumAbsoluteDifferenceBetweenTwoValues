//Brute Force
class Solution {
    public int minAbsoluteDifference(int[] nums) {
        int min = Integer.MAX_VALUE;
        int ans = -1;

        for(int i = 0;i<nums.length;i++){
            for(int j = i+1;j<nums.length;j++){
                if((nums[i] == 1 && nums[j] == 2) || (nums[i] == 2 && nums[j] == 1)){
                    ans = Math.abs(i - j);

                    if(min > ans){
                        min = ans;
                    } 
                }
            }

            
        }

        if(min == Integer.MAX_VALUE){
            return -1;
        }

        return min;
    }
}
