//Brute Force
class Solution {
    int maxLength(int arr[]) {
        // code here
        int sum = 0;
        int max = 0;
        int len;
        
        for(int i = 0;i<arr.length;i++){
            sum = arr[i];
            if(sum == 0){
                if(max < 1){
                    max = 1;
                }
            }
            
            for(int j = i+1;j<arr.length;j++){
                sum = sum + arr[j];
                if(sum == 0){
                    len = j - i + 1;
                    if(max < len){
                        max = len;
                    }
                }
            }
        }
        
        return max;
    }
}

//Optimized
class Solution {
    int maxLength(int arr[]) {
        // Because we're looking for the longest subarray, we keep the starting index as far left as possible
        HashMap<Integer, Integer> map = new HashMap<>();
        int sum = 0;
        int max = 0;
        int ind = 0;
        
        for(int i = 0;i<arr.length;i++){
            sum = sum + arr[i];
            
            if(sum == 0){
                max = i + 1;
            }
            
            if(map.containsKey(sum)){
                ind = i - map.get(sum);
                max = Math.max(max, ind);
            }else{
                map.put(sum, i);
            }
        }
        
        return max;
    }
}
