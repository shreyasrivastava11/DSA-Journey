// Brute Force
class Solution {
    public int missingNumber(int[] nums) {
        Arrays.sort(nums);
        for(int i = 0;i< nums.length;i++){
            if(nums[i] != i){
                return i;
            }
        }

        return nums.length;
    }
}

//Optimized
class Solution {
    public int missingNumber(int[] nums) {
        int xor = nums.length;
        for(int i = 0;i<nums.length;i++){
            xor = xor ^ i ^ nums[i];
        }

        return xor;
    }
}
